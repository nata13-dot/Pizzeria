{
  "expo": {
    "name": "pizzeria-front",
    "slug": "pizzeria-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nata13dot.pizzeriapos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#CF4B32",
          "defaultChannel": "orders_arrival_tone_v2",
          "sounds": [
            "./assets/notification_arrival.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Pizzería seleccione el logo del negocio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
